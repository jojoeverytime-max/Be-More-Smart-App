# Auth0 SPA application settings
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-client-id
VITE_AUTH0_AUDIENCE=https://api.studyday.local

# Keep the same values available to the Express API as well.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_AUDIENCE=https://api.studyday.local

# Express API and MongoDB
PORT=3001
MONGODB_URI=mongodb://127.0.0.1:27017/studyday
# Optional: set explicit DNS servers if the system resolver cannot resolve MongoDB Atlas SRV records.
MONGODB_DNS_SERVERS=

# Optional when the frontend and API are hosted on different origins
CLIENT_ORIGIN=http://localhost:5173
